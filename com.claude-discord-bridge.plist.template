<?xml version="1.0" encoding="UTF-8"?>
<!--
    LaunchAgent template. install.sh substitutes __HOME__ → $HOME before
    writing the rendered file to ~/Library/LaunchAgents/.
    Do not load this template file directly with launchctl.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.claude-discord-bridge</string>

    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.claude-discord/.venv/bin/python</string>
        <string>__HOME__/.claude-discord/listener.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__HOME__/.claude-discord</string>

    <!-- macOS LaunchAgents inherit a minimal environment. /usr/sbin is
         required because lsof lives there. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart on crash, but back off so an exception loop doesn't spin the
         CPU or rate-limit the Discord gateway. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/claude-discord/listener.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/claude-discord/listener.err.log</string>

    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>1024</integer>
    </dict>
</dict>
</plist>
