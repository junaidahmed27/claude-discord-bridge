<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.junaidahmed.claude-discord</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/junaidahmed/.claude-discord/.venv/bin/python</string>
        <string>/Users/junaidahmed/.claude-discord/listener.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/junaidahmed/.claude-discord</string>

    <!-- macOS LaunchAgents are stripped down. Inject the bits the listener needs
         (claude binary lives in /opt/homebrew/bin on Apple Silicon). -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/junaidahmed</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart on crash, but back off so an exception loop doesn't spin the
         CPU or rate-limit the Discord gateway. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/junaidahmed/Library/Logs/claude-discord/listener.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/junaidahmed/Library/Logs/claude-discord/listener.err.log</string>

    <!-- Limit resources so a runaway claude session doesn't OOM the machine. -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>1024</integer>
    </dict>
</dict>
</plist>
